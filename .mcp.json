{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schemas/mcp.schema.json",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "Acces avance au systeme de fichiers",
      "enabled": false
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "description": "Memoire persistante entre sessions",
      "enabled": false
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-fetch"],
      "description": "Requetes HTTP vers APIs externes",
      "enabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "Integration GitHub (issues, PRs, repos)",
      "enabled": false
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "description": "Connexion PostgreSQL pour requetes et migrations",
      "enabled": false
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-sqlite", "--db-path", "./data/local.db"],
      "description": "Base SQLite locale",
      "enabled": false
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-puppeteer"],
      "description": "Browser automation pour screenshots et tests UI",
      "enabled": false
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-sequential-thinking"],
      "description": "Raisonnement structure etape par etape",
      "enabled": false
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "description": "Integration Slack pour recherche de bugs, analyse de threads, et communication equipe (recommande par Boris Cherny)",
      "enabled": false
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-sentry"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}"
      },
      "description": "Integration Sentry pour analyse d'erreurs et monitoring (recommande par Boris Cherny)",
      "enabled": false
    },
    "bigquery": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-bigquery"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "BIGQUERY_PROJECT_ID": "${BIGQUERY_PROJECT_ID}"
      },
      "description": "Integration BigQuery pour requetes analytics directes (recommande par Boris Cherny - elimine l'ecriture manuelle de SQL)",
      "enabled": false
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-linear"],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      },
      "description": "Integration Linear pour gestion de projet et issues",
      "enabled": false
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-notion"],
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      },
      "description": "Integration Notion pour documentation et bases de connaissances",
      "enabled": false
    }
  }
}
