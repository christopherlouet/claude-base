{
  "$schema": "https://code.claude.com/schemas/mcp.json",
  "mcpServers": {
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-puppeteer"],
      "description": "Browser automation pour screenshots et tests UI",
      "enabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-filesystem", "--root", "."],
      "description": "Accès avancé au système de fichiers",
      "enabled": false
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-postgres"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "description": "Connexion PostgreSQL pour requêtes et migrations",
      "enabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "Intégration GitHub avancée",
      "enabled": false
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-fetch"],
      "description": "Requêtes HTTP vers APIs externes",
      "enabled": false
    }
  }
}
