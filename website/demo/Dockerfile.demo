# =============================================================================
# Demo recording environment for the README "60-second tour" asciinema cast.
#
# This image is NOT shipped to users — it's only used by website/demo/record.sh
# to produce a reproducible recording of `claude-base init + a real Claude
# session` inside an isolated environment.
#
# Build :   docker build -t claude-base-demo -f website/demo/Dockerfile.demo website/demo/
# Run   :   see website/demo/record.sh
# =============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color

# Minimal toolchain :
#   - curl + git + ca-certificates  → installer + foundation clone
#   - bash                          → the recorded shell
#   - tree                          → "show what was installed" step
#   - nodejs + npm                  → @anthropic-ai/claude-code prerequisite
#   - jq                            → install.sh dependency
#   - less                          → claude TUI pager fallback
#   - sudo                          → not used at runtime, only for image-build niceties
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git bash ca-certificates tree jq less \
        nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI globally (as root, before dropping privileges).
# Pinned to the latest available at image build time ; bump on demand by
# rebuilding the image.
RUN npm install -g @anthropic-ai/claude-code

# Rename Ubuntu 24.04's pre-existing `ubuntu` user (UID 1000) to `demo`,
# matching the typical host UID. The host's mounted ~/.claude/.claude.json
# are chmod 600, owned by the host's UID 1000 — using a UID 1001 user
# inside the container would silently fail to read them (Claude exits
# 0 with no output). install.sh refuses root, so a non-root user is
# required anyway.
RUN userdel --remove ubuntu 2>/dev/null ; rm -rf /home/ubuntu ; \
    useradd --uid 1000 --user-group --create-home --shell /bin/bash demo

# Recording entrypoint. Owned by demo so the script runs cleanly.
COPY --chown=demo:demo scenario.sh /usr/local/bin/scenario
RUN chmod +x /usr/local/bin/scenario

# Pre-warm a clean /home/demo/work workspace.
USER demo
ENV PATH="/home/demo/.local/bin:${PATH}"
WORKDIR /home/demo/work

CMD ["/bin/bash", "-l"]
