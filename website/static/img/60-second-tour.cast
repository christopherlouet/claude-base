{"version": 2, "width": 80, "height": 24, "timestamp": 1779285825, "idle_time_limit": 5.0, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}, "title": "claude-base — quick tour"}
[0.454655, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.455355, "o", "\r\n  \u001b[1;36m❯\u001b[0m Install the foundation\r\n\r\n"]
[1.4566, "o", "  \u001b[1;30m$\u001b[0m curl -fsSL \u001b[4;36mhttps://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh\u001b[0m | bash\r\n"]
[4.899712, "o", "\u001b[0;34m[INFO]\u001b[0m Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n\u001b[0;34m[INFO]\u001b[0m Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[7.904562, "o", "\u001b[H\u001b[2J\u001b[3J"]
[7.904945, "o", "\r\n  \u001b[1;36m❯\u001b[0m Drop the foundation into a new Next.js project\r\n\r\n"]
[8.907383, "o", "  \u001b[1;30m$\u001b[0m claude-base init --preset nextjs ./my-app\r\n"]
[10.587197, "o", "\u001b[0;34m[INFO]\u001b[0m Preset: Next.js full-stack (maintainer-vouched)\r\n\u001b[0;34m[INFO]\u001b[0m Installing claude-base in: /home/demo/work/my-app\r\n\u001b[0;34m[INFO]\u001b[0m Installing Claude files...\r\n\u001b[0;32m[OK]\u001b[0m Commands, skills, agents, rules, styles, templates, docs and hook scripts copied\r\n\u001b[0;32m[OK]\u001b[0m CLAUDE.md copied\r\n\u001b[0;32m[OK]\u001b[0m Design direction added: editorial\r\n"]
[14.592779, "o", "\u001b[H\u001b[2J\u001b[3J"]
[14.593176, "o", "\r\n  \u001b[1;36m❯\u001b[0m What landed on disk\r\n\r\n"]
[15.595473, "o", "  \u001b[1;30m$\u001b[0m ls .claude/\r\n"]
[16.40063, "o", "    \u001b[1;34magents\u001b[0m\r\n    \u001b[1;34mcommands\u001b[0m\r\n    \u001b[1;34mdocs\u001b[0m\r\n    \u001b[1;34moutput-styles\u001b[0m\r\n    \u001b[1;34mrules\u001b[0m\r\n    settings.json\r\n    \u001b[1;34mskills\u001b[0m\r\n    \u001b[1;34mtemplates\u001b[0m\r\n"]
[20.405901, "o", "\u001b[H\u001b[2J\u001b[3J"]
[20.40628, "o", "\r\n  \u001b[1;36m❯\u001b[0m Ask Claude — the foundation is now in context\r\n\r\n"]
[21.409113, "o", "  \u001b[1;30m$\u001b[0m claude --print '/assistant How to use /dev:dev-tdd?'\r\n"]
[41.349786, "o", "\u001b[1;36m# \u001b[0;32m/dev:dev-tdd\u001b[0m — TDD Development Guide\u001b[0m\r\n\r\n\u001b[1;33m## What it does\u001b[0m\r\n\r\n\u001b[0;32m/dev:dev-tdd\u001b[0m runs the \u001b[1mRed-Green-Refactor\u001b[0m cycle: tests are written BEFORE the code, then the minimal code is written to make them pass, and finally the code is refactored without breaking the tests.\r\n\r\nIt's a mandatory phase of the foundation workflow: \u001b[1mExplore → Specify → Plan → TDD → Audit → Commit\u001b[0m.\r\n\r\n\u001b[1;33m## How to invoke it\u001b[0m\r\n\r\n"]
[50.684362, "o", "\u001b[H\u001b[2J\u001b[3J"]
[50.684485, "o", "\r\n  \u001b[1;36m❯\u001b[0m Next : \u001b[1;32mcd ./my-app && claude\u001b[0m\r\n\r\n  Then drive the 6-phase workflow with one command :\r\n  \u001b[1;33m/work:work-flow-feature \"add a /counter route\"\u001b[0m\r\n\r\n  \u001b[4;36mhttps://github.com/christopherlouet/claude-base\u001b[0m\r\n\r\n"]
