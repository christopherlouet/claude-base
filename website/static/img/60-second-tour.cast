[0.319834, "o", "\r\n  \u001b[1;36m❯\u001b[0m Install the foundation\r\n\r\n"]
[1.321173, "o", "  \u001b[1;30m$\u001b[0m curl -fsSL https://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh | bash\r\n"]
[4.542195, "o", "\u001b[0;34m[INFO]\u001b[0m Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n\u001b[0;34m[INFO]\u001b[0m Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[7.546911, "o", "\u001b[H\u001b[2J\u001b[3J"]
[7.547317, "o", "\r\n  \u001b[1;36m❯\u001b[0m Drop the foundation into a new Next.js project\r\n\r\n"]
[8.550056, "o", "  \u001b[1;30m$\u001b[0m claude-base init --preset nextjs ./my-app\r\n"]
[10.283073, "o", "\u001b[0;34m\u001b[0;34m[INFO]\u001b[0m\u001b[0m Preset: Next.js full-stack (maintainer-vouched)\r\n\u001b[0;34m\u001b[0;34m[INFO]\u001b[0m\u001b[0m Installing claude-base in: /home/demo/work/my-app\r\n\u001b[0;34m\u001b[0;34m[INFO]\u001b[0m\u001b[0m Installing Claude files...\r\n\u001b[0;32m\u001b[0;32m[OK]\u001b[0m\u001b[0m Commands, skills, agents, rules, styles, templates, docs and hook scripts copied\r\n\u001b[0;32m\u001b[0;32m[OK]\u001b[0m\u001b[0m CLAUDE.md copied\r\n\u001b[0;32m\u001b[0;32m[OK]\u001b[0m\u001b[0m Design direction added: editorial\r\n"]
[14.287992, "o", "\u001b[H\u001b[2J\u001b[3J"]
[14.288319, "o", "\r\n  \u001b[1;36m❯\u001b[0m What landed on disk\r\n\r\n"]
