[0.403767, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.404703, "o", "\r\n  ❯ Install the foundation\r\n\r\n"]
[1.405674, "o", "  $ curl -fsSL https://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh | bash\r\n"]
[3.797108, "o", "[INFO] Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n[INFO] Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[5.301952, "o", "\u001b[H\u001b[2J\u001b[3J"]
[5.302386, "o", "\r\n  ❯ Drop the foundation into a new Next.js project\r\n\r\n"]
[6.305199, "o", "  $ claude-base init --preset nextjs ./my-app\r\n"]
