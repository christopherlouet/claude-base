[0.397171, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.398017, "o", "\r\n  \u001b[1;36m❯\u001b[0m Install the foundation\r\n\r\n"]
[1.399296, "o", "  \u001b[1;30m$\u001b[0m curl -fsSL \u001b[4;36mhttps://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh\u001b[0m | bash\r\n"]
[4.161497, "o", "\u001b[0;34m[INFO]\u001b[0m Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n\u001b[0;34m[INFO]\u001b[0m Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[8.164803, "o", "\u001b[H\u001b[2J\u001b[3J"]
[8.165032, "o", "\r\n  \u001b[1;36m❯\u001b[0m Drop the foundation into a new Next.js project\r\n\r\n"]
[9.166581, "o", "  \u001b[1;30m$\u001b[0m claude-base init --preset nextjs ./my-app\r\n"]
[10.405457, "o", "\u001b[0;34m[INFO]\u001b[0m Preset: Next.js full-stack (maintainer-vouched)\r\n\u001b[0;34m[INFO]\u001b[0m Installing claude-base in: /home/demo/work/my-app\r\n\u001b[0;34m[INFO]\u001b[0m Installing Claude files...\r\n\u001b[0;32m[OK]\u001b[0m Commands, skills, agents, rules, styles, templates, docs and hook scripts copied\r\n\u001b[0;32m[OK]\u001b[0m CLAUDE.md copied\r\n\u001b[0;32m[OK]\u001b[0m Design direction added: editorial\r\n"]
[14.409888, "o", "\u001b[H\u001b[2J\u001b[3J"]
[14.410348, "o", "\r\n  \u001b[1;36m❯\u001b[0m What landed on disk\r\n\r\n"]
[15.413008, "o", "  \u001b[1;30m$\u001b[0m ls .claude/\r\n"]
[16.2189, "o", "    \u001b[1;34magents\u001b[0m\r\n    \u001b[1;34mcommands\u001b[0m\r\n    \u001b[1;34mdocs\u001b[0m\r\n    \u001b[1;34moutput-styles\u001b[0m\r\n    \u001b[1;34mrules\u001b[0m\r\n    settings.json\r\n    \u001b[1;34mskills\u001b[0m\r\n    \u001b[1;34mtemplates\u001b[0m\r\n"]
[20.224369, "o", "\u001b[H\u001b[2J\u001b[3J"]
[20.22479, "o", "\r\n  \u001b[1;36m❯\u001b[0m Ask Claude — the foundation is now in context\r\n\r\n"]
[21.227547, "o", "  \u001b[1;30m$\u001b[0m claude --print '/assistant How to use /dev:dev-tdd?'\r\n"]
