[16.095789, "o", "    \u001b[1;34magents\u001b[0m\r\n    \u001b[1;34mcommands\u001b[0m\r\n    \u001b[1;34mdocs\u001b[0m\r\n    \u001b[1;34moutput-styles\u001b[0m\r\n    \u001b[1;34mrules\u001b[0m\r\n    settings.json\r\n    \u001b[1;34mskills\u001b[0m\r\n    \u001b[1;34mtemplates\u001b[0m\r\n"]
