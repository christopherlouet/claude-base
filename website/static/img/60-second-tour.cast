[0.358227, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.360137, "o", "\r\n  ❯ Install the foundation\r\n\r\n"]
[1.361556, "o", "  $ curl -fsSL https://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh | bash\r\n"]
[4.915366, "o", "[INFO] Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n[INFO] Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[7.918689, "o", "\u001b[H\u001b[2J\u001b[3J"]
[7.918898, "o", "\r\n  ❯ Drop the foundation into a new Next.js project\r\n\r\n"]
[8.920826, "o", "  $ claude-base init --preset nextjs ./my-app\r\n"]
