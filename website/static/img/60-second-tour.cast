[0.435231, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.437354, "o", "\r\n  \u001b[1;36m❯\u001b[0m Install the foundation\r\n\r\n"]
[1.438024, "o", "  \u001b[1;30m$\u001b[0m curl -fsSL https://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh | bash\r\n"]
[4.5598, "o", "\u001b[0;34m[INFO]\u001b[0m Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n\u001b[0;34m[INFO]\u001b[0m Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[7.563277, "o", "\u001b[H\u001b[2J\u001b[3J\r\n  \u001b[1;36m❯\u001b[0m Drop the foundation into a new Next.js project\r\n\r\n"]
[8.565418, "o", "  \u001b[1;30m$\u001b[0m claude-base init --preset nextjs ./my-app\r\n"]
[10.235692, "o", "\u001b[0;34m[INFO]\u001b[0m Preset: Next.js full-stack (maintainer-vouched)\r\n\u001b[0;34m[INFO]\u001b[0m Installing claude-base in: /home/demo/work/my-app\r\n\u001b[0;34m[INFO]\u001b[0m Installing Claude files...\r\n\u001b[0;32m[OK]\u001b[0m Commands, skills, agents, rules, styles, templates, docs and hook scripts copied\r\n\u001b[0;32m[OK]\u001b[0m CLAUDE.md copied\r\n\u001b[0;32m[OK]\u001b[0m Design direction added: editorial\r\n"]
[14.239207, "o", "\u001b[H\u001b[2J\u001b[3J"]
[14.239306, "o", "\r\n  \u001b[1;36m❯\u001b[0m What landed on disk\r\n\r\n"]
[15.241607, "o", "  \u001b[1;30m$\u001b[0m ls .claude/\r\n"]
[16.047994, "o", "    \u001b[1;34magents\u001b[0m\r\n    \u001b[1;34mcommands\u001b[0m\r\n    \u001b[1;34mdocs\u001b[0m\r\n    \u001b[1;34moutput-styles\u001b[0m\r\n    \u001b[1;34mrules\u001b[0m\r\n    settings.json\r\n    \u001b[1;34mskills\u001b[0m\r\n    \u001b[1;34mtemplates\u001b[0m\r\n"]
[20.053182, "o", "\u001b[H\u001b[2J\u001b[3J"]
[20.053764, "o", "\r\n  \u001b[1;36m❯\u001b[0m Ask Claude — the foundation is now in context\r\n\r\n"]
[21.056396, "o", "  \u001b[1;30m$\u001b[0m cd ./my-app && claude --print 'What does this foundation enforce in 2 sentences?'\r\n"]
[28.555807, "o", "This foundation enforces the mandatory workflow Explore → (Brainstorm) → Specify → Plan → TDD → Audit → Commit, with TDD writing tests before code and an audit loop targeting score 90 before commit. It also enforces Conventional Commits, 80%+ coverage, TypeScript strict mode (no `any`), secret-scanning, and main-branch protection via PreToolUse hooks.\r\n\u001b[?1006l\u001b[?1003l\u001b[?1002l\u001b[?1000l\u001b[>4m\u001b[<u\u001b[?1004l\u001b[?2031l\u001b[?2004l\u001b[?25h\u001b7\u001b[r\u001b8\u001b]0;\u0007\u001b[?25h"]
[33.560448, "o", "\u001b[H\u001b[2J\u001b[3J"]
[33.560558, "o", "\r\n  \u001b[1;36m❯\u001b[0m Next : \u001b[1;32mcd ./my-app && claude\u001b[0m\r\n\r\n  Then drive the 6-phase workflow with one command :\r\n  \u001b[1;33m/work:work-flow-feature \"add a /counter route\"\u001b[0m\r\n\r\n  \u001b[2;37mgithub.com/christopherlouet/claude-base\u001b[0m\r\n\r\n"]
