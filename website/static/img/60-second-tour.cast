[0.710815, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.712016, "o", "\r\n  \u001b[1;36m❯\u001b[0m Install the foundation\r\n\r\n"]
[1.713898, "o", "  \u001b[1;30m$\u001b[0m curl -fsSL \u001b[4;36mhttps://raw.githubusercontent.com/christopherlouet/claude-base/main/install.sh\u001b[0m | bash\r\n"]
[5.506745, "o", "\u001b[0;34m[INFO]\u001b[0m Cloning https://github.com/christopherlouet/claude-base.git into /home/demo/.local/share/claude-base\r\n\u001b[0;34m[INFO]\u001b[0m Linked /home/demo/.local/bin/claude-base → /home/demo/.local/share/claude-base/bin/claude-base\r\n"]
[8.511683, "o", "\u001b[H\u001b[2J\u001b[3J"]
[8.512078, "o", "\r\n  \u001b[1;36m❯\u001b[0m Drop the foundation into a new Next.js project\r\n\r\n"]
[9.514789, "o", "  \u001b[1;30m$\u001b[0m claude-base init --preset nextjs ./my-app\r\n"]
[11.3312, "o", "\u001b[0;34m[INFO]\u001b[0m Preset: Next.js full-stack (maintainer-vouched)\r\n\u001b[0;34m[INFO]\u001b[0m Installing claude-base in: /home/demo/work/my-app\r\n\u001b[0;34m[INFO]\u001b[0m Installing Claude files...\r\n\u001b[0;32m[OK]\u001b[0m Commands, skills, agents, rules, styles, templates, docs and hook scripts copied\r\n\u001b[0;32m[OK]\u001b[0m CLAUDE.md copied\r\n\u001b[0;32m[OK]\u001b[0m Design direction added: editorial\r\n"]
[15.336589, "o", "\u001b[H\u001b[2J\u001b[3J"]
[15.336948, "o", "\r\n  \u001b[1;36m❯\u001b[0m What landed on disk\r\n\r\n"]
[16.339759, "o", "  \u001b[1;30m$\u001b[0m ls .claude/\r\n"]
[17.145502, "o", "    \u001b[1;34magents\u001b[0m\r\n    \u001b[1;34mcommands\u001b[0m\r\n    \u001b[1;34mdocs\u001b[0m\r\n    \u001b[1;34moutput-styles\u001b[0m\r\n    \u001b[1;34mrules\u001b[0m\r\n    settings.json\r\n    \u001b[1;34mskills\u001b[0m\r\n    \u001b[1;34mtemplates\u001b[0m\r\n"]
[21.150769, "o", "\u001b[H\u001b[2J\u001b[3J"]
[21.151169, "o", "\r\n  \u001b[1;36m❯\u001b[0m Ask Claude — the foundation is now in context\r\n\r\n"]
[22.153941, "o", "  \u001b[1;30m$\u001b[0m claude --print '/assistant How to use /dev:dev-tdd?'\r\n"]
[43.687027, "o", "\u001b[1;36m# \u001b[0;32m/dev:dev-tdd\u001b[0m — TDD Development Guide\u001b[0m\r\n\r\n\u001b[1;33m## What it does\u001b[0m\r\n\r\nImplements a feature using the \u001b[1mRed-Green-Refactor\u001b[0m cycle: tests are written \u001b[1mBEFORE\u001b[0m the code, then the minimal implementation makes them pass, then refactoring improves quality without breaking tests.\r\n\r\n\u001b[1;33m## Syntax\u001b[0m\r\n\r\n\u001b[2;37m```\u001b[0m\r\n/dev:dev-tdd \"feature description\"\r\n"]
[59.084673, "o", "\u001b[H\u001b[2J\u001b[3J"]
[59.084759, "o", "\r\n  \u001b[1;36m❯\u001b[0m Next : \u001b[1;32mcd ./my-app && claude\u001b[0m\r\n\r\n  Then drive the 6-phase workflow with one command :\r\n  \u001b[1;33m/work:work-flow-feature \"add a /counter route\"\u001b[0m\r\n\r\n  \u001b[4;36mhttps://github.com/christopherlouet/claude-base\u001b[0m\r\n\r\n"]
