# MCP Servers - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# Activez les serveurs dans .mcp.json ("enabled": true)

# GitHub MCP (gh auth status pour verifier)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# PostgreSQL MCP
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Slack MCP (recommande par Boris Cherny)
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
# SLACK_TEAM_ID=T00000000

# Sentry MCP (recommande par Boris Cherny)
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
# SENTRY_ORG=your-org

# BigQuery MCP (recommande par Boris Cherny)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# BIGQUERY_PROJECT_ID=your-project-id

# Linear MCP
# LINEAR_API_KEY=lin_api_xxxxxxxxxxxx

# Notion MCP
# NOTION_API_KEY=ntn_xxxxxxxxxxxx
