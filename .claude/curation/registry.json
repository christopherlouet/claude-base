{
  "_comment": "canonicalVendor registry — source of truth for foundation→vendor graduation candidates (EF-001, EF-011). Seeded from specs/marketplace-audit/ POINT-TO-VENDOR + REDUCE-TO-POINTER verdicts. This is DISTINCT from .claude/presets/*.json recommendedVendorSkills[]: a registry record marks a foundation skill as a graduation candidate; a preset recommendation surfaces a vendor skill for a stack. The two sets overlap but are not identical. Durable workflow skills carry NO record here (absence = permanence signal, EF-001). Records are re-verified by scripts/curation-watch.sh (Slice 3).",
  "version": "1.0.0",
  "recordSchema": {
    "foundationSkill": "id of the graduatable foundation skill (matches the audit verdict row)",
    "vendorId": "canonical replacement vendor skill (repo or repo subpath). A '+'-joined subpath (e.g. coreyhaines31/marketingskills/cro+analytics) is a human notation meaning the foundation skill maps to SEVERAL skills inside one repo — it is NOT a literal filesystem path; resolvers must split on '+' and resolve each against the repo at pinnedRef.",
    "vendorUrl": "pointer to the vendor skill repo (never copied — EF-010). For a marketplace plugin the URL may be the marketplace page while pinnedRef resolves against the underlying git repo (see dev-frontend-design).",
    "pinnedRef": "immutable reference: release tag or full commit SHA (EF-005)",
    "trustTrack": "authority (vendor's own org, low popularity bar) | community (third-party, high bar) — EF-003",
    "trustVerdict": "pass | flag | fail — outcome of the trust criterion (scored by scripts/lib/trust-score.sh in Slice 2)",
    "provenance": "disclosed publisher (EF-008)",
    "adviceNeutrality": "pass | flag — does the skill push proprietary lock-in / away from Claude? (EF-008)",
    "lastVerified": "ISO date the pin + signals were last re-verified",
    "status": "candidate | graduating | graduated",
    "sourceAudit": "audit pilot the verdict came from (traceability)",
    "flags": "optional array of advisory notes (e.g. missing license, REDUCE planned)"
  },
