#!/usr/bin/env sh

# Downstream commit-msg hook, installed by `claude-base init --hooks`.
#
# Validates the Conventional Commits format via commitlint (config shipped
# alongside as .commitlintrc.json). Runs only when commitlint is INSTALLED:
# guarding on npx and package.json said nothing about the tool, and on a Node
# project that had not added it yet `npx --no` refused to fetch it and every
# commit was refused. A hook never downloads a tool; absent, it no-ops.

if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$1"
fi
