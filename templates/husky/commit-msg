#!/usr/bin/env sh

# Downstream commit-msg hook, installed by `claude-base init --hooks`.
#
# Validates the Conventional Commits format via commitlint (config shipped
# alongside as .commitlintrc.json). Runs only when commitlint is INSTALLED:
# guarding on npx and package.json said nothing about the tool, and on a Node
# project that had not added it yet `npx --no` refused to fetch it and every
# commit was refused. A hook never downloads a tool; absent, it steps aside,
# and says so in a Node project — a skipped gate must not read as a passed one.
#
# The shipped .commitlintrc.json extends @commitlint/config-conventional, which
# commitlint resolves at run time: with only @commitlint/cli installed it
# refused EVERY commit. Absent, the check steps aside and says so. A project's
# own config is run as is. A package.json below the root (web/, frontend/) is
# named, since the hook runs at the root and finds nothing to run.
# SKIP_COMMITLINT=1 turns the check off, silently.

if [ "${SKIP_COMMITLINT:-0}" = "1" ]; then
  :
elif [ -x node_modules/.bin/commitlint ]; then
  if [ ! -d node_modules/@commitlint/config-conventional ] && [ -f .commitlintrc.json ] \
     && grep -q '@commitlint/config-conventional' .commitlintrc.json; then
    echo "commit-msg: @commitlint/config-conventional not installed (.commitlintrc.json extends it) - message check skipped" >&2
  else
    node_modules/.bin/commitlint --edit "$1"
  fi
elif [ -f package.json ]; then
  echo "commit-msg: commitlint not installed in node_modules - message check skipped" >&2
else
  nested=$(find . -maxdepth 2 -path ./node_modules -prune -o -name package.json -print 2>/dev/null | head -n 1)
  if [ -n "$nested" ]; then
    echo "commit-msg: package.json is not at the repository root (${nested#./}) - message check skipped" >&2
  fi
fi
