#!/usr/bin/env sh

# Downstream pre-commit hook, installed by `claude-base init --hooks`.
#
# Deliberately NOT a copy of the foundation's own .husky/pre-commit: that one
# invokes scripts that exist only in the foundation checkout (the private-names
# check, the derived-counts self-heal). An install does not ship them, so the
# copy called files that were not there and refused every commit once
# git-hooks-wire.sh set core.hooksPath on the first session.
#
# What is left is what a project actually has: lint-staged, and only when it
# is INSTALLED. A guard on npx and package.json let `npx lint-staged` try to
# download it on a project that had not added it, which fails offline and
# refuses the commit. A hook never downloads a tool; absent, it steps aside —
# a gate nobody feeds must not block the work — and says so in a Node project,
# so a skipped gate does not read as a passed one.
#
# A package.json below the root that sets lint-staged up (web/, apps/web/) is
# named, since the hook runs at the root and finds nothing to run; one that does
# not (a docs site), or that git does not track, is not. SKIP_LINT_STAGED=1
# turns the check off, silently.

# The user's GLOBAL pre-commit runs first. This repository's local
# core.hooksPath shadows a global one, so a personal guard installed with
# `git config --global core.hooksPath <dir>` would otherwise never run here.
# No global value, no such hook, or the global hook IS this file: nothing to do.
_global_hooks=$(git config --global --path core.hooksPath 2>/dev/null || true)
if [ -n "$_global_hooks" ] && [ -x "$_global_hooks/pre-commit" ] && ! [ "$_global_hooks/pre-commit" -ef "$0" ]; then
  "$_global_hooks/pre-commit" "$@" || exit 1
fi

if [ "${SKIP_LINT_STAGED:-0}" = "1" ]; then
  :
elif [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged
elif [ -f package.json ]; then
  echo "pre-commit: lint-staged not installed in node_modules - staged lint skipped" >&2
else
  # Tracked files only: an ignored scratch clone is not the project.
  parts=$(git ls-files -- '*/package.json' ':!:*node_modules/*' 2>/dev/null \
    | while IFS= read -r f; do grep -q '"lint-staged"' "$f" 2>/dev/null && dirname "$f"; done | sort | tr '\n' ' ')
  parts=${parts% }
  if [ -n "$parts" ]; then
    echo "pre-commit: lint-staged is set up in $parts, not at the repository root - staged lint skipped" >&2
  fi
fi
