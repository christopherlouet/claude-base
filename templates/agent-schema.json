{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude-base/agent-schema.json",
  "title": "Claude-Base Agent Schema",
  "description": "Validation schema for claude-base agents",
  "type": "object",
  "required": ["title", "description", "context", "objective"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Agent title in the format '# Agent NAME'",
      "pattern": "^# Agent [A-Z][A-Z0-9-]*$"
    },
    "description": {
      "type": "string",
      "description": "Short description of the agent (1-2 lines)",
      "minLength": 10,
      "maxLength": 200
    },
    "context": {
      "type": "string",
      "description": "Section containing the $ARGUMENTS placeholder",
      "pattern": "\\$ARGUMENTS"
    },
    "objective": {
      "type": "string",
      "description": "Main objective of the agent",
      "minLength": 20
    },
    "sections": {
      "type": "array",
      "description": "Content sections of the agent",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "description": "Section title (## Heading)"
          },
          "content": {
            "type": "string",
            "description": "Section content"
          }
        },
        "required": ["heading"]
      }
    },
    "checklist": {
      "type": "array",
      "description": "List of steps to follow",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "relatedAgents": {
      "type": "array",
      "description": "Related agents",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^/[a-z]+-?[a-z-]*$"
          },
          "usage": {
            "type": "string"
          }
        },
        "required": ["name", "usage"]
      }
    },
    "instructions": {
      "type": "object",
      "description": "Special instructions at the end of the file",
      "properties": {
        "important": {
          "type": "array",
          "items": { "type": "string" }
        },
        "youMust": {
          "type": "array",
          "items": { "type": "string" }
        },
        "never": {
          "type": "array",
          "items": { "type": "string" }
        },
        "thinkHard": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Agent metadata",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["work", "dev", "qa", "ops", "doc", "biz", "growth", "legal"],
          "description": "Agent category"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "medium", "complex"],
          "description": "Agent complexity"
        },
        "minLines": {
          "type": "integer",
          "minimum": 50,
          "description": "Recommended minimum number of lines"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    }
  }
}
