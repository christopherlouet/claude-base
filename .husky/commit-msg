#!/usr/bin/env sh

# The user's GLOBAL commit-msg runs first. This repository's local
# core.hooksPath shadows a global one, so a personal guard installed with
# `git config --global core.hooksPath <dir>` would otherwise never run here.
# No global value, no such hook, or the global hook IS this file: nothing to do.
_global_hooks=$(git config --global --path core.hooksPath 2>/dev/null || true)
if [ -n "$_global_hooks" ] && [ -x "$_global_hooks/commit-msg" ] && ! [ "$_global_hooks/commit-msg" -ef "$0" ]; then
  "$_global_hooks/commit-msg" "$@" || exit 1
fi

# Validate commit message format (conventional commits, requires package.json with commitlint)
if command -v npx >/dev/null 2>&1 && [ -f "package.json" ]; then
  npx --no -- commitlint --edit "$1"
fi
