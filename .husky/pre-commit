#!/usr/bin/env sh

# Privacy gate: this repo is PUBLIC and is developed against real personal
# projects, so their names leak into docs, specs and fixtures by accident. The
# protected-name list lives OUTSIDE the repo (~/.claude/private-names by
# default) — no list means a silent no-op, so a fresh clone is never blocked.
# Scans only what the commit ADDS. Disable with SKIP_PRIVATE_NAMES=1.
# See scripts/private-names-check.sh, pinned by tests/private-names-check.bats.
bash scripts/private-names-check.sh || exit 1

# Counts self-heal: when a commit stages an input the CI counts gate derives
# from, regenerate the derived count files and stage them, so a stale count can
# never reach CI. The trigger set must cover EVERY input generate-counts.ts /
# sync-docs.ts read — counted resources, presets, the marketplace
# pilot specs, docs/ (mirrored to website/docs/), the minimal manifest and
# VERSION. A class missing here commits cleanly locally and fails the CI
# counts gate ("forgot to regenerate" — the top lesson of this repo). No-op
# (and node-free) for every other commit. See scripts/sync-counts.sh.
# Disable with SKIP_COUNTS_SYNC=1. Pinned by tests/ci-workflows.bats.
if [ "${SKIP_COUNTS_SYNC:-0}" != "1" ]; then
  if git diff --cached --name-only \
       | grep -qE '^\.claude/(commands|agents|skills|rules|presets)/|^docs/|^specs/marketplace-audit/|^scripts/lib/minimal-manifest\.txt$|^VERSION$'; then
    bash scripts/sync-counts.sh --quiet || exit 1
  fi
fi

# Pristine hashes: `update` replaces a hook script without --force only when its
# hash is a version the foundation shipped. A commit touching a managed script
# regenerates and stages that table, so the version it replaces is never
# missing (tests/pristine-hashes.bats checks the same in CI). A shallow clone
# cannot derive it: say so and let CI catch it, rather than refuse the commit.
# Disable with SKIP_PRISTINE_HASHES=1.
if [ "${SKIP_PRISTINE_HASHES:-0}" != "1" ]; then
  if git diff --cached --name-only \
       | grep -qE '^scripts/hooks/[^/]+\.sh$|^scripts/substance-check\.sh$'; then
    rc=0
    bash scripts/gen-pristine-hashes.sh || rc=$?
    if [ "$rc" -eq 0 ]; then
      git add scripts/lib/pristine-hashes.txt || exit 1
    elif [ "$rc" -eq 2 ]; then
      echo "[pre-commit] pristine-hashes table not regenerated (shallow clone) - CI will check it."
    else
      exit 1
    fi
  fi
fi

# Run lint-staged for staged files only (requires package.json with lint-staged)
if command -v npx >/dev/null 2>&1 && [ -f "package.json" ]; then
  npx lint-staged
fi
