# EditorConfig - Consistent formatting configuration
# https://editorconfig.org

root = true

# Default configuration
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Bash scripts
[*.sh]
indent_size = 4
shell_variant = bash

# JSON configuration files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# TOML files
[*.toml]
indent_size = 2

# Makefiles (require tabs)
[Makefile]
indent_style = tab

# Bats test files
[*.bats]
indent_size = 4
shell_variant = bash

# Docker files
[Dockerfile*]
indent_size = 4

# Git configuration files
[.git*]
indent_size = 4
